# Same official Node 22 bookworm-slim base as codex-container, pinned by digest.
FROM docker.io/library/node:22-bookworm-slim@sha256:43aeff40f4afc22e83f7589a2f37e111cff5ca84529571f1c8415bcc5fcc21b2

USER root
# Keep this step identical in both agent images so the layer is shared.
# Build tools for testing/building projects; agents add other toolchains
# (rustup, uv, Go) to their writable home at runtime.
# (slim images lack man1, which the OpenJDK package scripts need)
RUN mkdir -p /usr/share/man/man1 \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates git ripgrep openssh-client curl procps file less \
      zip unzip xz-utils bzip2 build-essential pkg-config libssl-dev \
      python3 python3-dev python3-venv python3-pip openjdk-17-jdk-headless \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/agent
COPY package.json package-lock.json ./
# The native Claude CLI ships as a locked optional dependency; no scripts run.
RUN npm ci --omit=dev --ignore-scripts \
 && npm cache clean --force

# Pinned adapters first, then toolchains the agents install into their home.
ENV PATH="/opt/agent/node_modules/.bin:/home/node/.local/bin:/home/node/.cargo/bin:/home/node/.local/go/bin:/home/node/go/bin:${PATH}" \
    NPM_CONFIG_PREFIX=/home/node/.local \
    JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64 \
    HOME=/home/node \
    CLAUDE_CONFIG_DIR=/home/node/.claude \
    DISABLE_AUTOUPDATER=1 \
    DISABLE_TELEMETRY=1 \
    NO_BROWSER=1 \
    GIT_CONFIG_GLOBAL=/opt/agent-git/gitconfig

# Mount targets for the connector's optional gitconfig, SSH agent socket and
# push host keys
# (the root filesystem is read-only at runtime).
RUN mkdir -p /opt/agent-git \
 && touch /opt/agent-git/gitconfig /opt/agent-git/ssh-agent.sock /opt/agent-git/known_hosts
RUN mkdir -p /home/node/.claude /workspace \
 && chown node:node /home/node/.claude
COPY settings.json /home/node/.claude/settings.json
RUN chown node:node /home/node/.claude/settings.json
USER node
WORKDIR /workspace
ENTRYPOINT []
CMD ["claude-agent-acp"]
