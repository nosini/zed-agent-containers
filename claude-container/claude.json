{
  "mcpServers": {
    "rea": {
      "type": "stdio",
      "command": "ssh",
      "args": [
        "-T",
        "-F",
        "/home/node/.ssh/agent-vm.conf",
        "agent-vm",
        "/usr/local/bin/rea",
        "mcp"
      ],
      "timeout": 1200000
    },
    "docx-mcp": {
      "type": "stdio",
      "command": "/opt/office-mcp/docx/bin/docx-mcp-server",
      "args": []
    },
    "excel": {
      "type": "stdio",
      "command": "/opt/office-mcp/excel/bin/excel-mcp-server",
      "args": [
        "stdio"
      ]
    }
  }
}
