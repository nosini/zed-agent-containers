// Merge into ~/.var/app/dev.zed.Zed/config/zed/settings.json ("agent_servers").
// Runs inside the Flatpak; needs no host escape. The client only relays to
// the host broker socket named by ACP_CONNECTOR; each socket is bound to one
// fixed container on the host. Leave "args" as is: the client rejects arguments.
{
  "agent_servers": {
    "Codex (container)": {
      "type": "custom",
      "command": "/usr/bin/python3",
      "args": ["-I", "/home/nosini/.var/app/dev.zed.Zed/data/acp-connector/acp-client.py"],
      "env": { "ACP_CONNECTOR": "codex" }
    },
    "Claude Code (container)": {
      "type": "custom",
      "command": "/usr/bin/python3",
      "args": ["-I", "/home/nosini/.var/app/dev.zed.Zed/data/acp-connector/acp-client.py"],
      "env": { "ACP_CONNECTOR": "claude" }
    },
    "Claude Code B (container)": {
      "type": "custom",
      "command": "/usr/bin/python3",
      "args": ["-I", "/home/nosini/.var/app/dev.zed.Zed/data/acp-connector/acp-client.py"],
      "env": { "ACP_CONNECTOR": "claude-b" }
    },
    "OpenCode (container)": {
      "type": "custom",
      "command": "/usr/bin/python3",
      "args": ["-I", "/home/nosini/.var/app/dev.zed.Zed/data/acp-connector/acp-client.py"],
      "env": { "ACP_CONNECTOR": "opencode" }
    },
    // Optional: the same agents with Teams for Linux's MCP bridge (README).
    "Codex + Teams (container)": {
      "type": "custom",
      "command": "/usr/bin/python3",
      "args": ["-I", "/home/nosini/.var/app/dev.zed.Zed/data/acp-connector/acp-client.py"],
      "env": { "ACP_CONNECTOR": "codex-teams" }
    },
    "Claude Code + Teams (container)": {
      "type": "custom",
      "command": "/usr/bin/python3",
      "args": ["-I", "/home/nosini/.var/app/dev.zed.Zed/data/acp-connector/acp-client.py"],
      "env": { "ACP_CONNECTOR": "claude-teams" }
    },
    "OpenCode + Teams (container)": {
      "type": "custom",
      "command": "/usr/bin/python3",
      "args": ["-I", "/home/nosini/.var/app/dev.zed.Zed/data/acp-connector/acp-client.py"],
      "env": { "ACP_CONNECTOR": "opencode-teams" }
    }
  }
}
