[Unit]
Description=Agent VM SSH and keep-awake sockets

[Socket]
ListenStream=/run/acp-agent-vm/ssh.sock
ListenStream=/run/acp-agent-vm/control.sock
SocketMode=0600
DirectoryMode=0755
# The installer adds SocketUser=<desktop UID> in a root-owned drop-in.
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
