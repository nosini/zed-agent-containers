[Unit]
Description=ACP broker: Zed (Flatpak) to Claude Code with Teams in per-project containers
Requires=claude-teams-acp-connector.socket
After=claude-teams-acp-connector.socket
# Create the claude-agent-state and shared agent-home volumes (Quadlet) if needed.
Wants=claude-agent-state-volume.service agent-home-volume.service
After=claude-agent-state-volume.service agent-home-volume.service

[Service]
Type=simple
# The same options as the claude profile, plus Teams for Linux's MCP bridge,
# which only the Teams profiles accept:
#   teams.env: ACP_TEAMS_OPTS="--teams-socket S"
EnvironmentFile=-%h/.config/acp-connector/broker.env
EnvironmentFile=-%h/.config/acp-connector/teams.env
# Installed outside ~/Git so project files can't change host code.
# Each Zed connection gets a fresh container: ~/Git read-only, the project
# Zed started the agent in read-write, and the Teams socket read-only.
ExecStart=/usr/bin/python3 -I %h/.local/libexec/acp-connector/acp-broker.py --profile claude-teams --git-root %h/Git $ACP_BROKER_OPTS $ACP_TEAMS_OPTS
UMask=0077
Restart=on-failure
# No NoNewPrivileges: rootless Podman may need setuid newuidmap.
# No Install section: activated by claude-teams-acp-connector.socket.
