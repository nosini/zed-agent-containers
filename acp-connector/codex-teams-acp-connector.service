[Unit]
Description=ACP broker: Zed (Flatpak) to Codex with Teams in per-project containers
Requires=codex-teams-acp-connector.socket
After=codex-teams-acp-connector.socket
# Create the codex-agent-state and shared agent-home volumes (Quadlet) if needed.
Wants=codex-agent-state-volume.service agent-home-volume.service
After=codex-agent-state-volume.service agent-home-volume.service

[Service]
Type=simple
# The same options as the codex profile, plus Teams for Linux's MCP bridge,
# which only the Teams profiles accept:
#   teams.env: ACP_TEAMS_OPTS="--teams-socket S"
EnvironmentFile=-%h/.config/acp-connector/broker.env
EnvironmentFile=-%h/.config/acp-connector/teams.env
# Installed outside ~/Git so project files can't change host code.
# Each Zed connection gets a fresh container: ~/Git read-write, working in
# the project Zed started the agent in, and the Teams socket read-only.
ExecStart=/usr/bin/python3 -I %h/.local/libexec/acp-connector/acp-broker.py --profile codex-teams --git-root %h/Git $ACP_BROKER_OPTS $ACP_TEAMS_OPTS
UMask=0077
Restart=on-failure
# No NoNewPrivileges: rootless Podman may need setuid newuidmap.
# No Install section: activated by codex-teams-acp-connector.socket.
