# Official Node 22 bookworm-slim, pinned to the manifest verified during setup.
FROM docker.io/library/node:22-bookworm-slim@sha256:d20a7b8b4184bf74fe77499b5460a3d69e582bc733d50287e40c3fe791764851

USER root
# Keep this step identical in both agent images so the layer is shared.
# Build tools for testing/building projects; agents add other toolchains
# (rustup, uv, Go) to their writable home at runtime.
# Chromium renders Univer Workspace screenshots and PDFs (uvw, below).
# (slim images lack man1, which the OpenJDK package scripts need)
RUN mkdir -p /usr/share/man/man1 \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates git ripgrep openssh-client curl procps file less \
      zip unzip xz-utils bzip2 build-essential pkg-config libssl-dev meson ninja-build \
      python3 python3-dev python3-venv python3-pip python3-packaging python3-yaml \
      node-jsdom \
      openjdk-17-jdk-headless \
      flatpak-builder rpm \
      chromium fonts-liberation \
 && rm -rf /var/lib/apt/lists/*

# The Word and Excel MCP servers, each in its own venv (docx-mcp needs the
# mcp 1.x API, excel-mcp-server 2.x), from the hash-pinned wheels in
# ../office-mcp (build with --build-context office-mcp=../office-mcp).
# Also identical in both images, so this layer is shared too.
COPY --from=office-mcp docx.txt excel.txt /opt/office-mcp/
RUN for server in docx excel; do \
      python3 -m venv /opt/office-mcp/$server \
      && /opt/office-mcp/$server/bin/pip install --no-cache-dir --disable-pip-version-check \
           --no-deps --require-hashes --only-binary=:all: -r /opt/office-mcp/$server.txt \
      || exit 1; \
    done

# The Univer Workspace CLI (uvw), pinned with its dependencies in
# ../univer-cli (build with --build-context univer-cli=../univer-cli). Its
# native parts are prebuilt packages, so no install scripts run. Linked into
# /usr/local/bin, which login shells keep on PATH. Identical in both images.
WORKDIR /opt/univer-workspace-cli
COPY --from=univer-cli package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund \
 && npm cache clean --force \
 && ln -s /opt/univer-workspace-cli/node_modules/.bin/uvw \
      /opt/univer-workspace-cli/node_modules/.bin/univer-workspace-cli /usr/local/bin/

# Antigravity CLI: one native binary, no npm package. The release pinned in
# agy-release.env (by ../update.sh) is downloaded and checked against its
# SHA-512 before anything runs. It lives in the read-only image, so it can't
# update itself; new releases come with ../update.sh.
WORKDIR /opt/agent
COPY agy-release.env ./
RUN . ./agy-release.env \
 && curl -fsSL --retry 3 -o /tmp/agy.tar.gz "$AGY_URL" \
 && echo "$AGY_SHA512  /tmp/agy.tar.gz" | sha512sum -c - \
 && tar -xzf /tmp/agy.tar.gz -C /opt/agent antigravity \
 && rm /tmp/agy.tar.gz \
 && chmod 755 /opt/agent/antigravity \
 && ln -s /opt/agent/antigravity /usr/local/bin/agy \
 && HOME=/tmp/agy-home agy --help >/dev/null \
 && rm -rf /tmp/agy-home
# The Univer Workspace CLI's Skill, copied into ~/.gemini/config/skills by
# start-agent.py, since Antigravity CLI reads Skills only from there.
COPY --from=univer-cli SKILL.md /opt/agent/skills/univer-workspace-cli/SKILL.md
# The broker starts one command per connection: start-agent.py writes the
# image's MCP servers and Skill into ~/.gemini, then runs `agy acp`.
COPY start-agent.py /usr/local/bin/antigravity-acp
RUN chmod 755 /usr/local/bin/antigravity-acp

# Pinned adapters first, then toolchains the agents install into their home.
ENV PATH="/home/node/.local/bin:/home/node/.cargo/bin:/home/node/.local/go/bin:/home/node/go/bin:${PATH}" \
    NPM_CONFIG_PREFIX=/home/node/.local \
    JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64 \
    HOME=/home/node \
    UNIVER_HOME=/home/node/.gemini/univer-workspace \
    UNIVER_RENDER_BROWSER=/usr/bin/chromium \
    NO_BROWSER=1 \
    GIT_CONFIG_GLOBAL=/opt/agent-git/gitconfig

# Mount targets for the connector's optional gitconfig, SSH agent socket and
# push host keys
# (the root filesystem is read-only at runtime).
RUN mkdir -p /opt/agent-git \
 && touch /opt/agent-git/gitconfig /opt/agent-git/ssh-agent.sock /opt/agent-git/known_hosts
RUN mkdir -p /opt/agent-vm && touch /opt/agent-vm-client.py
# REA's MCP server runs on the VM. This proxy (build with
# --build-context rea-mcp=../rea-mcp) answers the MCP handshake from a saved
# listing and connects over SSH only when a REA tool is used, so starting
# an agent session doesn't boot the VM or keep it awake.
COPY --from=rea-mcp rea-mcp.py rea-listing.json.gz /opt/rea-mcp/
RUN chmod 755 /opt/rea-mcp/rea-mcp.py && ln -s /opt/rea-mcp/rea-mcp.py /usr/local/bin/rea-mcp
# ~/.gemini (login, settings, conversations, MCP servers, Skills) is the
# state volume.
RUN mkdir -p /home/node/.gemini /workspace \
 && chown -R node:node /home/node/.gemini
USER node
WORKDIR /workspace
ENTRYPOINT []
CMD ["antigravity-acp"]
