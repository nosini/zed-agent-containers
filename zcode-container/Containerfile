# Same official Node 22 bookworm-slim base as the other agents, pinned by digest.
FROM docker.io/library/node:22-bookworm-slim@sha256:25330af3531fb5e23318554a0aa911125b6e91b1b777edf7655501d207c067a2

USER root
# Keep this step identical in all agent images so the layer is shared.
# Build tools for testing/building projects; agents add other toolchains
# (rustup, uv, Go) to their writable home at runtime.
# (slim images lack man1, which the OpenJDK package scripts need)
RUN mkdir -p /usr/share/man/man1 \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates git ripgrep openssh-client curl procps file less \
      zip unzip xz-utils bzip2 build-essential pkg-config libssl-dev \
      python3 python3-dev python3-venv python3-pip openjdk-17-jdk-headless \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/agent
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts \
 && npm cache clean --force

# Pinned adapter and CLI first, then toolchains in the writable home.
ENV PATH="/opt/agent/node_modules/.bin:/home/node/.local/bin:/home/node/.cargo/bin:/home/node/.local/go/bin:/home/node/go/bin:${PATH}" \
    NPM_CONFIG_PREFIX=/home/node/.local \
    JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64 \
    HOME=/home/node \
    ZCODE_DISABLE_UPDATE_CHECK=1 \
    NO_BROWSER=1 \
    GIT_CONFIG_GLOBAL=/opt/agent-git/gitconfig

# Mount targets for the connector's optional gitconfig, SSH agent socket and
# push host keys
# (the root filesystem is read-only at runtime).
RUN mkdir -p /opt/agent-git \
 && touch /opt/agent-git/gitconfig /opt/agent-git/ssh-agent.sock /opt/agent-git/known_hosts
RUN mkdir -p /home/node/.zcode /workspace \
 && chown node:node /home/node/.zcode
USER node
WORKDIR /workspace
ENTRYPOINT []
CMD ["zcode-acp-server"]
